{
  "name": "ananya-thorat-portfolio-root",
  "version": "1.0.0",
  "private": true,
  "description": "Ananya Thorat Portfolio Root Workspace and Netlify Serverless Backend",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "node server/devServer.js",
    "build": "npm run build --prefix client"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "googleapis": "^144.0.0",
    "nodemailer": "^6.10.0"
  }
}
